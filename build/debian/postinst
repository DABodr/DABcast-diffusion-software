#!/bin/bash
set -e

LOGFILE=/var/log/dabcast-install.log

# stderr goes to the log file: every command error is recorded there
exec 2>>"$LOGFILE"

# Unexpected failure (set -e): note it in the log
trap 'echo "$(date "+%Y-%m-%d %H:%M:%S") [FAILED] postinst interrupted (code: $?)" >> "$LOGFILE"' ERR

log() {
  echo "[dabcast] $1"
  echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOGFILE"
}

case "$1" in
  configure)
    log "=== Installation DABcast ==="
    log "dpkg version  : $2 -> $1"
    log "Architecture : $(dpkg --print-architecture 2>/dev/null || echo unknown)"
    log "Kernel       : $(uname -r)"
    log ""

    # --- Service user ---
    # Priority: RUN_AS_USER in /etc/default/dabcast > SUDO_USER > first user with UID >= 1000
    RUN_AS_USER=""
    if [ -f /etc/default/dabcast ]; then
      # shellcheck disable=SC1091
      . /etc/default/dabcast
    fi

    if [ -z "$RUN_AS_USER" ]; then
      # Auto-detection: the user who ran sudo dpkg -i
      if [ -n "$SUDO_USER" ] && id -u "$SUDO_USER" >/dev/null 2>&1; then
        RUN_AS_USER="$SUDO_USER"
        log "[1/5] User detected from SUDO_USER: $RUN_AS_USER"
      else
        # Last resort: first non-system account (UID >= 1000)
        RUN_AS_USER=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 {print $1; exit}')
        log "[1/5] User detected (first UID >= 1000): $RUN_AS_USER"
      fi
    else
      log "[1/5] User set in /etc/default/dabcast: $RUN_AS_USER"
    fi

    if [ -z "$RUN_AS_USER" ] || ! id -u "$RUN_AS_USER" >/dev/null 2>&1; then
      log "  ERROR: cannot determine the service user."
      log "  Set RUN_AS_USER in /etc/default/dabcast and install again."
      exit 1
    fi
    RUN_AS_GROUP=$(id -gn "$RUN_AS_USER")
    log "  -> User: $(id "$RUN_AS_USER")"
    log "  -> Primary group: $RUN_AS_GROUP"

    # Service unit patched with that user
    sed -i "s/^User=.*/User=$RUN_AS_USER/" /lib/systemd/system/dabcast.service
    sed -i "s/^Group=.*/Group=$RUN_AS_GROUP/" /lib/systemd/system/dabcast.service
    log "  -> Service unit: User=$RUN_AS_USER Group=$RUN_AS_GROUP"

    # --- Data directories ---
    log "[2/5] Creating the data directories..."
    for dir in /var/lib/dabcast/presets \
                /var/lib/dabcast/logs \
                /var/lib/dabcast/runtime \
                /var/lib/dabcast/mot; do
      mkdir -p "$dir"
      log "  -> $dir"
    done

    # --- Permissions ---
    log "[3/5] Setting permissions..."
    chown -R "$RUN_AS_USER:$RUN_AS_GROUP" /var/lib/dabcast
    chmod 750 /var/lib/dabcast
    chmod 755 /opt/dabcast/bin/dabcast
    chmod 600 /etc/default/dabcast
    log "  -> /var/lib/dabcast  : $(stat -c '%U:%G %a' /var/lib/dabcast)"
    log "  -> /opt/dabcast/bin/dabcast : $(stat -c '%U:%G %a' /opt/dabcast/bin/dabcast)"
    log "  -> /etc/default/dabcast : $(stat -c '%U:%G %a' /etc/default/dabcast)"

    # --- Binary check ---
    log "[4/5] Checking the binary..."
    BINFILE=/opt/dabcast/bin/dabcast
    if [ -f "$BINFILE" ]; then
      log "  -> Size: $(du -sh "$BINFILE" | cut -f1)"
      log "  -> Type:$(file "$BINFILE" | cut -d: -f2-)"
    else
      log "  ERROR: binary missing: $BINFILE"
    fi

    # --- Systemd ---
    log "[5/5] systemd service..."
    log "  -> Unit file: $(ls -lh /lib/systemd/system/dabcast.service 2>/dev/null || echo ABSENT)"
    log "  -> /etc/default/dabcast: $(ls -lh /etc/default/dabcast 2>/dev/null || echo ABSENT)"
    systemctl daemon-reload
    systemctl enable dabcast.service
    log "  -> Service enabled"

    # systemd is running when /run/systemd/system exists (standard test). 'is-system-running' is not
    # used any more: it fails on a "degraded" system (any other failed unit), and the service was
    # then left stopped after an install or a one-click update.
    if [ -d /run/systemd/system ]; then
      log "  -> Starting the service..."
      systemctl start dabcast.service || log "  WARNING: start failed (see: journalctl -u dabcast -n 30)"
    else
      log "  -> systemd not running (container / live system): service not started"
    fi

    # --- Privileged update helper ---
    log "[+] Installing the update helper..."
    # written next to the old one, then moved into place in one step (new inode): during a one-click
    # update the former helper is still running from this file, and bash reads a script as it goes —
    # overwriting it in place could make it run lines of the new file as root
    cat > /opt/dabcast/bin/dabcast-install-update.new << 'UPDATER'
#!/bin/bash
# dabcast-install-update — run as root by the dabcast service (sudo rule below) for the one-click and the
# automatic updates. It downloads the OFFICIAL release X.Y.Z itself (fixed GitHub address, HTTPS) into a
# private root-only directory, checks the package name / version / architecture, then installs it. It never
# installs a file supplied by the caller (former versions installed any /tmp/dabcast-update_*.deb: a local
# user could get a package installed as root).
#   dabcast-install-update --prefetch X.Y.Z   download and check only (the multiplex keeps broadcasting)
#   dabcast-install-update X.Y.Z              install (the prefetched package when there is one), then watch
#                                             the restarted service: when it does not stay up, the previous
#                                             version is installed again (helper v2, packages from 1.12)
set -euo pipefail
PREFETCH=0
if [[ "${1:-}" == "--prefetch" ]]; then PREFETCH=1; shift; fi
VERSION="${1:-}"
if [[ ! "$VERSION" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
  echo "usage: dabcast-install-update [--prefetch] X.Y.Z" >&2
  exit 2
fi
ARCH=$(dpkg --print-architecture)
if [[ "$ARCH" != "amd64" && "$ARCH" != "arm64" ]]; then
  echo "dabcast-install-update: unsupported architecture $ARCH" >&2
  exit 2
fi
CACHE=/var/cache/dabcast-update   # root only: prefetched packages
install -d -m 700 -o root -g root "$CACHE"
DIR=$(mktemp -d)   # 0700, owned by root
trap 'rm -rf "$DIR"' EXIT

# download X.Y.Z into $2 and check it (exit 3 download, 4 unexpected package)
fetch() {
  local ver="$1" out="$2"
  local url="https://github.com/DABodr/DABcast-diffusion-software/releases/download/v${ver}/dabcast_${ver}_${ARCH}.deb"
  echo "dabcast-install-update: downloading $url"
  # download with the Node.js embedded in the dabcast binary (no curl / wget needed); "PROGRESS n" lines
  PKG_EXECPATH=PKG_INVOKE_NODEJS DABCAST_UPDATE_URL="$url" DABCAST_UPDATE_OUT="$out" /opt/dabcast/bin/dabcast -e '
const fs = require("fs");
(async () => {
  const r = await fetch(process.env.DABCAST_UPDATE_URL, { redirect: "follow", headers: { "User-Agent": "DABcast-updater" }, signal: AbortSignal.timeout(300000) });
  if (!r.ok) { console.error("download failed: HTTP " + r.status); process.exit(3); }
  const total = Number(r.headers.get("content-length") || 0);
  const out = fs.createWriteStream(process.env.DABCAST_UPDATE_OUT, { mode: 0o600 });
  let got = 0, last = -1;
  for await (const chunk of r.body) {
    out.write(chunk);
    got += chunk.length;
    const p = total ? Math.floor(got * 100 / total) : 0;
    if (p !== last) { last = p; console.log("PROGRESS " + p); }
  }
  await new Promise((ok, ko) => { out.end(); out.on("finish", ok); out.on("error", ko); });
})().catch((e) => { console.error("download failed: " + e.message); process.exit(3); });
'
  check "$ver" "$out"
}
check() {
  local ver="$1" pkg="$2" field
  for field in Package:dabcast "Version:$ver" "Architecture:$ARCH"; do
    if [[ "$(dpkg-deb -f "$pkg" "${field%%:*}" 2>/dev/null)" != "${field#*:}" ]]; then
      echo "dabcast-install-update: unexpected package (${field%%:*} is not ${field#*:}), not installed" >&2
      return 4
    fi
  done
}
CACHED="$CACHE/dabcast_${VERSION}_${ARCH}.deb"

if [[ $PREFETCH -eq 1 ]]; then
  find "$CACHE" -maxdepth 1 -name 'dabcast_*.deb' ! -name "$(basename "$CACHED")" -delete
  fetch "$VERSION" "$DIR/dabcast.deb"
  mv -f "$DIR/dabcast.deb" "$CACHED"
  echo "PREFETCHED"
  exit 0
fi

PKG="$DIR/dabcast.deb"
if [[ -f "$CACHED" ]] && check "$VERSION" "$CACHED"; then
  mv -f "$CACHED" "$PKG"
  echo "dabcast-install-update: package downloaded in advance"
else
  rm -f "$CACHED"
  fetch "$VERSION" "$PKG"
fi
PREV=$(dpkg-query -W -f='${Version}' dabcast 2>/dev/null || true)
echo "INSTALLING"
# From here the package's prerm stops the dabcast service, which reads this output through a pipe:
# a write to that broken pipe killed dpkg with SIGPIPE in the middle of the installation (package
# half-installed, service stopped and disabled). Output now goes to a log file, hang-up / broken pipe
# ignored.
trap '' HUP PIPE
exec >>/var/log/dabcast-update.log 2>&1
dpkg_install() {
  echo "$(date '+%F %T') installing DABcast $1 ($ARCH)"
  # dpkg busy (PackageKit / unattended-upgrades on a desktop): retry every 10 s, 3 minutes at most
  local attempt=0 out rc
  while :; do
    out=$(LC_ALL=C dpkg -i "$2" 2>&1) && rc=0 || rc=$?
    printf '%s\n' "$out"
    if [[ $rc -ne 0 && "$out" == *"lock"* && $attempt -lt 18 ]]; then
      attempt=$((attempt + 1))
      echo "$(date '+%F %T') dpkg is busy (lock), retry $attempt/18 in 10 s"
      sleep 10
      continue
    fi
    break
  done
  [[ $rc -eq 0 ]] || echo "$(date '+%F %T') dpkg failed (code $rc)"
  # the package starts the service; in any case it must not stay stopped / disabled
  systemctl enable dabcast.service >/dev/null 2>&1 || true
  systemctl start dabcast.service >/dev/null 2>&1 || true
  return $rc
}
# the service must stay up 40 s in a row within 2 minutes (a version that cannot start — port taken,
# crash at start-up — is restarted by systemd every 5 s and never does)
stays_up() {
  local up=0 t
  for t in $(seq 1 120); do
    if systemctl is-active --quiet dabcast.service; then up=$((up + 1)); else up=0; fi
    [[ $up -ge 40 ]] && return 0
    sleep 1
  done
  return 1
}
rc=0
dpkg_install "$VERSION" "$PKG" || rc=$?
if stays_up; then
  echo "$(date '+%F %T') DABcast $VERSION running"
  exit $rc
fi
echo "$(date '+%F %T') DABcast $VERSION does not stay up"
if [[ "$PREV" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ && "$PREV" != "$VERSION" ]]; then
  echo "$(date '+%F %T') rolling back to $PREV"
  if fetch "$PREV" "$DIR/previous.deb" && dpkg_install "$PREV" "$DIR/previous.deb" && stays_up; then
    echo "$(date '+%F %T') rolled back: DABcast $PREV running"
    exit 5
  fi
  echo "$(date '+%F %T') rollback to $PREV failed: check the server (journalctl -u dabcast)"
fi
exit 6
UPDATER
    chmod 755 /opt/dabcast/bin/dabcast-install-update.new
    mv -f /opt/dabcast/bin/dabcast-install-update.new /opt/dabcast/bin/dabcast-install-update
    log "  -> /opt/dabcast/bin/dabcast-install-update installed"

    # sudoers rule: the service user may run this helper only
    SUDOERS_FILE=/etc/sudoers.d/dabcast-update
    echo "$RUN_AS_USER ALL=(root) NOPASSWD: /opt/dabcast/bin/dabcast-install-update" > "$SUDOERS_FILE"
    chmod 440 "$SUDOERS_FILE"
    if visudo -c -f "$SUDOERS_FILE" >/dev/null 2>&1; then
      log "  -> sudoers rule installed for $RUN_AS_USER"
    else
      rm -f "$SUDOERS_FILE"
      log "  WARNING: invalid sudoers rule, one-click update not available"
    fi

    log ""
    log "=== Installation complete ==="
    log "Installed paths:"
    log "  Binary       : /opt/dabcast/bin/dabcast"
    log "  Web UI       : /opt/dabcast/web/"
    log "  Data         : /var/lib/dabcast/ (owner: $RUN_AS_USER)"
    log "  Service      : /lib/systemd/system/dabcast.service"
    log "  Environment  : /etc/default/dabcast"
    log "  This log     : $LOGFILE"
    log ""
    log "If something goes wrong:"
    log "  journalctl -u dabcast -n 50 --no-pager"
    log "  systemctl status dabcast"
    log "  sudo -u $RUN_AS_USER env DABCAST_DATA_DIR=/var/lib/dabcast /opt/dabcast/bin/dabcast"
    ;;
esac

exit 0
