#!/bin/bash
set -e

LOGFILE=/var/log/dabcast-install.log

# stderr goes to the log file: every command error is recorded there
exec 2>>"$LOGFILE"

# Unexpected failure (set -e): note it in the log
trap 'echo "$(date "+%Y-%m-%d %H:%M:%S") [FAILED] postinst interrupted (code: $?)" >> "$LOGFILE"' ERR

log() {
  echo "[dabcast] $1"
  echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOGFILE"
}

case "$1" in
  configure)
    log "=== Installation DABcast ==="
    log "dpkg version  : $2 -> $1"
    log "Architecture : $(dpkg --print-architecture 2>/dev/null || echo unknown)"
    log "Kernel       : $(uname -r)"
    log ""

    # --- Service user ---
    # Priority: RUN_AS_USER in /etc/default/dabcast > SUDO_USER > first user with UID >= 1000
    RUN_AS_USER=""
    if [ -f /etc/default/dabcast ]; then
      # shellcheck disable=SC1091
      . /etc/default/dabcast
    fi

    if [ -z "$RUN_AS_USER" ]; then
      # Auto-detection: the user who ran sudo dpkg -i
      if [ -n "$SUDO_USER" ] && id -u "$SUDO_USER" >/dev/null 2>&1; then
        RUN_AS_USER="$SUDO_USER"
        log "[1/5] User detected from SUDO_USER: $RUN_AS_USER"
      else
        # Last resort: first non-system account (UID >= 1000)
        RUN_AS_USER=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 {print $1; exit}')
        log "[1/5] User detected (first UID >= 1000): $RUN_AS_USER"
      fi
    else
      log "[1/5] User set in /etc/default/dabcast: $RUN_AS_USER"
    fi

    if [ -z "$RUN_AS_USER" ] || ! id -u "$RUN_AS_USER" >/dev/null 2>&1; then
      log "  ERROR: cannot determine the service user."
      log "  Set RUN_AS_USER in /etc/default/dabcast and install again."
      exit 1
    fi
    RUN_AS_GROUP=$(id -gn "$RUN_AS_USER")
    log "  -> User: $(id "$RUN_AS_USER")"
    log "  -> Primary group: $RUN_AS_GROUP"

    # Service unit patched with that user
    sed -i "s/^User=.*/User=$RUN_AS_USER/" /lib/systemd/system/dabcast.service
    sed -i "s/^Group=.*/Group=$RUN_AS_GROUP/" /lib/systemd/system/dabcast.service
    log "  -> Service unit: User=$RUN_AS_USER Group=$RUN_AS_GROUP"

    # --- Data directories ---
    log "[2/5] Creating the data directories..."
    for dir in /var/lib/dabcast/presets \
                /var/lib/dabcast/logs \
                /var/lib/dabcast/runtime \
                /var/lib/dabcast/mot; do
      mkdir -p "$dir"
      log "  -> $dir"
    done

    # --- Permissions ---
    log "[3/5] Setting permissions..."
    chown -R "$RUN_AS_USER:$RUN_AS_GROUP" /var/lib/dabcast
    chmod 750 /var/lib/dabcast
    chmod 755 /opt/dabcast/bin/dabcast
    chmod 600 /etc/default/dabcast
    log "  -> /var/lib/dabcast  : $(stat -c '%U:%G %a' /var/lib/dabcast)"
    log "  -> /opt/dabcast/bin/dabcast : $(stat -c '%U:%G %a' /opt/dabcast/bin/dabcast)"
    log "  -> /etc/default/dabcast : $(stat -c '%U:%G %a' /etc/default/dabcast)"

    # --- Binary check ---
    log "[4/5] Checking the binary..."
    BINFILE=/opt/dabcast/bin/dabcast
    if [ -f "$BINFILE" ]; then
      log "  -> Size: $(du -sh "$BINFILE" | cut -f1)"
      log "  -> Type:$(file "$BINFILE" | cut -d: -f2-)"
    else
      log "  ERROR: binary missing: $BINFILE"
    fi

    # --- Systemd ---
    log "[5/5] systemd service..."
    log "  -> Unit file: $(ls -lh /lib/systemd/system/dabcast.service 2>/dev/null || echo ABSENT)"
    log "  -> /etc/default/dabcast: $(ls -lh /etc/default/dabcast 2>/dev/null || echo ABSENT)"
    systemctl daemon-reload
    systemctl enable dabcast.service
    log "  -> Service enabled"

    # systemd is running when /run/systemd/system exists (standard test). 'is-system-running' is not
    # used any more: it fails on a "degraded" system (any other failed unit), and the service was
    # then left stopped after an install or a one-click update.
    if [ -d /run/systemd/system ]; then
      log "  -> Starting the service..."
      systemctl start dabcast.service || log "  WARNING: start failed (see: journalctl -u dabcast -n 30)"
    else
      log "  -> systemd not running (container / live system): service not started"
    fi

    # --- Privileged update helper ---
    log "[+] Installing the update helper..."
    cat > /opt/dabcast/bin/dabcast-install-update << 'UPDATER'
#!/bin/bash
# dabcast-install-update X.Y.Z — run as root by the dabcast service (sudo rule below) for the
# one-click update. It downloads the OFFICIAL release X.Y.Z itself (fixed GitHub address, HTTPS)
# into a private root-only directory, checks the package name / version / architecture, then
# installs it. It never installs a file supplied by the caller (former versions installed any
# /tmp/dabcast-update_*.deb: a local user could get a package installed as root).
set -euo pipefail
VERSION="${1:-}"
if [[ ! "$VERSION" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
  echo "usage: dabcast-install-update X.Y.Z" >&2
  exit 2
fi
ARCH=$(dpkg --print-architecture)
if [[ "$ARCH" != "amd64" && "$ARCH" != "arm64" ]]; then
  echo "dabcast-install-update: unsupported architecture $ARCH" >&2
  exit 2
fi
URL="https://github.com/DABodr/DABcast-diffusion-software/releases/download/v${VERSION}/dabcast_${VERSION}_${ARCH}.deb"
DIR=$(mktemp -d)   # 0700, owned by root
trap 'rm -rf "$DIR"' EXIT
PKG="$DIR/dabcast.deb"
echo "dabcast-install-update: downloading $URL"
# download with the Node.js embedded in the dabcast binary (no curl / wget needed); "PROGRESS n" lines
PKG_EXECPATH=PKG_INVOKE_NODEJS DABCAST_UPDATE_URL="$URL" DABCAST_UPDATE_OUT="$PKG" /opt/dabcast/bin/dabcast -e '
const fs = require("fs");
(async () => {
  const r = await fetch(process.env.DABCAST_UPDATE_URL, { redirect: "follow", headers: { "User-Agent": "DABcast-updater" }, signal: AbortSignal.timeout(300000) });
  if (!r.ok) { console.error("download failed: HTTP " + r.status); process.exit(3); }
  const total = Number(r.headers.get("content-length") || 0);
  const out = fs.createWriteStream(process.env.DABCAST_UPDATE_OUT, { mode: 0o600 });
  let got = 0, last = -1;
  for await (const chunk of r.body) {
    out.write(chunk);
    got += chunk.length;
    const p = total ? Math.floor(got * 100 / total) : 0;
    if (p !== last) { last = p; console.log("PROGRESS " + p); }
  }
  await new Promise((ok, ko) => { out.end(); out.on("finish", ok); out.on("error", ko); });
})().catch((e) => { console.error("download failed: " + e.message); process.exit(3); });
'
for field in Package:dabcast "Version:$VERSION" "Architecture:$ARCH"; do
  if [[ "$(dpkg-deb -f "$PKG" "${field%%:*}")" != "${field#*:}" ]]; then
    echo "dabcast-install-update: unexpected package (${field%%:*} is not ${field#*:}), not installed" >&2
    exit 4
  fi
done
echo "INSTALLING"
dpkg -i "$PKG"
UPDATER
    chmod 755 /opt/dabcast/bin/dabcast-install-update
    log "  -> /opt/dabcast/bin/dabcast-install-update installed"

    # sudoers rule: the service user may run this helper only
    SUDOERS_FILE=/etc/sudoers.d/dabcast-update
    echo "$RUN_AS_USER ALL=(root) NOPASSWD: /opt/dabcast/bin/dabcast-install-update" > "$SUDOERS_FILE"
    chmod 440 "$SUDOERS_FILE"
    if visudo -c -f "$SUDOERS_FILE" >/dev/null 2>&1; then
      log "  -> sudoers rule installed for $RUN_AS_USER"
    else
      rm -f "$SUDOERS_FILE"
      log "  WARNING: invalid sudoers rule, one-click update not available"
    fi

    log ""
    log "=== Installation complete ==="
    log "Installed paths:"
    log "  Binary       : /opt/dabcast/bin/dabcast"
    log "  Web UI       : /opt/dabcast/web/"
    log "  Data         : /var/lib/dabcast/ (owner: $RUN_AS_USER)"
    log "  Service      : /lib/systemd/system/dabcast.service"
    log "  Environment  : /etc/default/dabcast"
    log "  This log     : $LOGFILE"
    log ""
    log "If something goes wrong:"
    log "  journalctl -u dabcast -n 50 --no-pager"
    log "  systemctl status dabcast"
    log "  sudo -u $RUN_AS_USER env DABCAST_DATA_DIR=/var/lib/dabcast /opt/dabcast/bin/dabcast"
    ;;
esac

exit 0
